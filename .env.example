# ───────────── Database (Neon) ─────────────
# Pooled connection string (host contains "-pooler") — used by web + worker at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used ONLY by prisma migrate / seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ───────────── Secrets ─────────────
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=""
# Better Auth: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the web app (http://localhost:3000 locally, your Vercel URL in prod)
BETTER_AUTH_URL="http://localhost:3000"

# ───────────── LLM (any OpenAI-compatible Chat Completions endpoint; Gemini by default) ─────────────
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY=""
LLM_MODEL_MAIN=""
LLM_MODEL_SMALL=""
# Thinking models: "low" cuts latency and quota use. none | minimal | low | medium | high
# (gemini-3.8-flash rejects "minimal"; "none" was no faster than "low" in testing.)
LLM_REASONING_EFFORT=low
# Extra completion tokens allowed for hidden reasoning (added to each agent's output ceiling)
LLM_REASONING_TOKEN_HEADROOM=2000
# Resilience: per-attempt timeout, retries (5xx/timeouts/hinted 429s), longest wait we accept before a retry.
# Exhausted quota (e.g. the free tier's daily cap) is NOT retried: it fails fast with a plain-language error.
LLM_REQUEST_TIMEOUT_MS=45000
LLM_MAX_RETRIES=3
LLM_MAX_RETRY_DELAY_MS=20000
# Process-wide caps to stay under the provider's quota (0 = unlimited). Set the RPM to your tier's limit.
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=0
# USD per 1,000,000 tokens (check the provider's pricing page; used for per-step cost + spend cap).
# Output price also applies to hidden reasoning tokens (billed as total_tokens - prompt tokens).
LLM_PRICE_MAIN_INPUT_PER_1M=""
LLM_PRICE_MAIN_OUTPUT_PER_1M=""
LLM_PRICE_SMALL_INPUT_PER_1M=""
LLM_PRICE_SMALL_OUTPUT_PER_1M=""

# ───────────── Limits ─────────────
DAILY_SPEND_CAP_USD=5
RUNS_PER_USER_PER_DAY=30
# Max runs one IP may start or retry per 10 minutes (stored in Postgres, so it holds across instances)
RUNS_PER_IP_PER_10_MIN=20
# Budget reserved for each run still in flight when checking the daily spend cap (set near your real cost per run)
ESTIMATED_RUN_COST_USD=0.05

# ───────────── Worker (optional; defaults shown) ─────────────
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1000
WORKER_SHUTDOWN_GRACE_MS=60000

# ───────────── Testing ─────────────
# 1 = canned LLM outputs for Playwright. The app REFUSES TO START if this is set with NODE_ENV=production.
MOCK_LLM=0

# ───────────── Seed accounts (used by `pnpm db:seed` only; passwords >= 8 chars) ─────────────
SEED_EBUN_EMAIL=""
SEED_EBUN_PASSWORD=""
SEED_OPS2_NAME=""
SEED_OPS2_EMAIL=""
SEED_OPS2_PASSWORD=""
SEED_TUTOR1_NAME="Daniel Reyes"
SEED_TUTOR1_EMAIL=""
SEED_TUTOR1_PASSWORD=""
SEED_TUTOR2_NAME="Sophie Lindqvist"
SEED_TUTOR2_EMAIL=""
SEED_TUTOR2_PASSWORD=""
