# ───────────── Database (Neon) ─────────────
# Pooled connection string (host contains "-pooler") — used by web + worker at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used ONLY by prisma migrate / seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ───────────── Secrets ─────────────
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=""
# Better Auth: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the web app (http://localhost:3000 locally, your Vercel URL in prod)
BETTER_AUTH_URL="http://localhost:3000"

# ───────────── OpenAI ─────────────
OPENAI_API_KEY=""
OPENAI_MODEL_MAIN=""
OPENAI_MODEL_SMALL=""
# USD per 1,000,000 tokens (check your provider's pricing page; used for per-step cost + spend cap)
OPENAI_PRICE_MAIN_INPUT_PER_1M=""
OPENAI_PRICE_MAIN_OUTPUT_PER_1M=""
OPENAI_PRICE_SMALL_INPUT_PER_1M=""
OPENAI_PRICE_SMALL_OUTPUT_PER_1M=""

# ───────────── Limits ─────────────
DAILY_SPEND_CAP_USD=5
RUNS_PER_USER_PER_DAY=30

# ───────────── Testing ─────────────
# 1 = canned LLM outputs for Playwright. The app REFUSES TO START if this is set with NODE_ENV=production.
MOCK_LLM=0

# ───────────── Seed accounts (used by `pnpm db:seed` only; passwords >= 12 chars) ─────────────
SEED_EBUN_EMAIL=""
SEED_EBUN_PASSWORD=""
SEED_OPS2_NAME=""
SEED_OPS2_EMAIL=""
SEED_OPS2_PASSWORD=""
SEED_TUTOR1_NAME="Daniel Reyes"
SEED_TUTOR1_EMAIL=""
SEED_TUTOR1_PASSWORD=""
SEED_TUTOR2_NAME="Sophie Lindqvist"
SEED_TUTOR2_EMAIL=""
SEED_TUTOR2_PASSWORD=""
