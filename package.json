{
  "name": "mssuzie-session-copilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @mssuzie/core db:generate",
    "db:migrate": "pnpm --filter @mssuzie/core db:migrate",
    "db:deploy": "pnpm --filter @mssuzie/core db:deploy",
    "db:seed": "pnpm --filter @mssuzie/core db:seed",
    "run-session": "pnpm --filter @mssuzie/core run-session",
    "eval": "pnpm --filter @mssuzie/core eval",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:db:up": "bash scripts/test-db.sh up",
    "test:db:down": "bash scripts/test-db.sh down",
    "test:db": "bash scripts/test-db.sh up && TEST_DATABASE_URL=\"$(bash scripts/test-db.sh url)\" pnpm test",
    "worker": "pnpm --filter @mssuzie/worker start",
    "reschedule": "pnpm --filter @mssuzie/core reschedule",
    "e2e": "bash scripts/e2e.sh"
  }
}
